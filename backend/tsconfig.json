{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",

    "lib": ["ES2022"],

    "rootDir": ".",
    "outDir": "dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,

    "declaration": false,
    "sourceMap": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    "typeRoots": [
      "./node_modules/@types",
      "./src/types"
    ]
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "scripts/**/*.ts",
    "shared/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}